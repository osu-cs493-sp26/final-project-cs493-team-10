    {
      "name": "create-user",
      "item": [
        {
          "name": "public student creation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(",
                  "    \"newStudentEmail\",",
                  "    `student-${Date.now()}@tarpaulin.edu`",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"returns the new user ID\", function () {",
                  "    pm.expect(pm.response.json().id).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
