  "item": [
    {
      "name": "login",
      "item": [
        {
          "name": "valid admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"returns a JWT\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"adminToken\", body.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@tarpaulin.edu\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          },
          "response": []
        },
