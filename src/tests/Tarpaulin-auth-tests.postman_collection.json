            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{newStudentEmail}}\",\n  \"password\": \"password\",\n  \"role\": \"student\"\n}",
              "options": {
