    {
      "name": "assignments",
      "description": "Assignment CRUD. The GET /assignments/1 read hits seed data only. Create/edit/delete all target a throwaway assignment (createdAssignmentId) that belongs to the temp course, so seed assignments are never modified. courseId is immutable on update.",
      "item": [
        {
          "name": "POST /assignments — owner creates on temp course (201)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 + id', () => { pm.response.to.have.status(201); pm.collectionVariables.set('createdAssignmentId', pm.response.json().id); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{instructorToken}}" } ], "body": { "mode": "raw", "raw": "{\"courseId\":{{createdCourseId}},\"title\":\"Final Project\",\"points\":100,\"due\":\"2025-06-10T23:59:00Z\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/assignments", "host": ["{{baseUrl}}"], "path": ["assignments"] } },
          "response": []
        },
