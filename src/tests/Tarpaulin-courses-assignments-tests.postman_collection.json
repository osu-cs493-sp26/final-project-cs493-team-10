{
  "info": {
    "name": "Tarpaulin-courses-assignments-DEMO",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "adminToken", "value": "" },
    { "key": "instructorToken", "value": "" },
    { "key": "otherInstructorToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "createdCourseId", "value": "" },
    { "key": "createdAssignmentId", "value": "" }
  ],
  "item": [
    {
      "name": "setup - login (run first)",
      "description": "Logs in seeded users and stores their JWTs as collection variables. admin=alice, owning instructor=bob (teaches course 1), non-owning instructor=carol, student=dave. All seeded passwords are 'password'.",
      "item": [
        {
          "name": "login admin (alice)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + token', () => { pm.response.to.have.status(200); pm.collectionVariables.set('adminToken', pm.response.json().token); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\"email\":\"alice@tarpaulin.edu\",\"password\":\"password\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] } },
          "response": []
        },
        {
          "name": "login instructor (bob, owns course 1)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + token', () => { pm.response.to.have.status(200); pm.collectionVariables.set('instructorToken', pm.response.json().token); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\"email\":\"bob@tarpaulin.edu\",\"password\":\"password\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] } },
          "response": []
        },
        {
          "name": "login other instructor (carol, no course 1)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + token', () => { pm.response.to.have.status(200); pm.collectionVariables.set('otherInstructorToken', pm.response.json().token); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\"email\":\"carol@tarpaulin.edu\",\"password\":\"password\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] } },
          "response": []
        },
        {
          "name": "login student (dave)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + token', () => { pm.response.to.have.status(200); pm.collectionVariables.set('studentToken', pm.response.json().token); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\"email\":\"dave@tarpaulin.edu\",\"password\":\"password\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] } },
          "response": []
        }
      ]
    },
    {
      "name": "courses",
      "description": "Course CRUD, list filtering + pagination, enrollment, students list, and roster CSV. Public reads need no token; create/delete are admin-only; update/enroll/students/roster are admin OR the course's own instructor.",
      "item": [
        {
          "name": "GET /courses — paginated list (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + paginated courses', () => { pm.response.to.have.status(200); pm.expect(j.courses).to.be.an('array'); pm.expect(j.totalPages).to.be.a('number'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] } },
          "response": []
        },
        {
          "name": "GET /courses?subject=MATH — filtering (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + only MATH courses', () => { pm.response.to.have.status(200); j.courses.forEach(c => pm.expect(c.subject_code).to.eql('MATH')); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses?subject=MATH", "host": ["{{baseUrl}}"], "path": ["courses"], "query": [ { "key": "subject", "value": "MATH" } ] } },
          "response": []
        },
        {
          "name": "GET /courses?page=2 — pagination (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + page 2 with prevPage link', () => { pm.response.to.have.status(200); pm.expect(j.page).to.eql(2); pm.expect(j.links).to.have.property('prevPage'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses?page=2", "host": ["{{baseUrl}}"], "path": ["courses"], "query": [ { "key": "page", "value": "2" } ] } },
          "response": []
        },
        {
          "name": "GET /courses?term=W2025 — filtering by term (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + only W2025 courses', () => { pm.response.to.have.status(200); j.courses.forEach(c => pm.expect(c.term).to.eql('W2025')); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses?term=W2025", "host": ["{{baseUrl}}"], "path": ["courses"], "query": [ { "key": "term", "value": "W2025" } ] } },
          "response": []
        },
        {
          "name": "POST /courses — admin creates (201)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 + id', () => { pm.response.to.have.status(201); pm.collectionVariables.set('createdCourseId', pm.response.json().id); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "body": { "mode": "raw", "raw": "{\"subject_code\":\"CS\",\"number\":493,\"title\":\"Cloud Application Development\",\"term\":\"S2025\",\"instructor_id\":2}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] } },
          "response": []
        },
        {
          "name": "GET /courses/{{createdCourseId}} — confirm the create",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + returns the course just created', () => { pm.response.to.have.status(200); pm.expect(j.subject_code).to.eql('CS'); pm.expect(j.number).to.eql(493); pm.expect(j.title).to.eql('Cloud Application Development'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses/{{createdCourseId}}", "host": ["{{baseUrl}}"], "path": ["courses", "{{createdCourseId}}"] } },
          "response": []
        },
        {
          "name": "POST /courses — student forbidden (403)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{studentToken}}" } ], "body": { "mode": "raw", "raw": "{\"subject_code\":\"CS\",\"number\":494,\"title\":\"X\",\"term\":\"S2025\",\"instructor_id\":2}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] } },
          "response": []
        },
        {
          "name": "GET /courses/1 — detail + counts (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + studentCount/assignmentCount', () => { pm.response.to.have.status(200); pm.expect(j.studentCount).to.be.a('number'); pm.expect(j.assignmentCount).to.be.a('number'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses/1", "host": ["{{baseUrl}}"], "path": ["courses", "1"] } },
          "response": []
        },
        {
          "name": "PATCH /courses/1 — owner instructor edits (200)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } } ],
          "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{instructorToken}}" } ], "body": { "mode": "raw", "raw": "{\"title\":\"Intro to Programming (edited)\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/courses/1", "host": ["{{baseUrl}}"], "path": ["courses", "1"] } },
          "response": []
        },
        {
          "name": "GET /courses/1 — confirm the edit applied",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + title reflects the PATCH', () => { pm.response.to.have.status(200); pm.expect(j.title).to.eql('Intro to Programming (edited)'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses/1", "host": ["{{baseUrl}}"], "path": ["courses", "1"] } },
          "response": []
        },
        {
          "name": "PATCH /courses/1 — non-owner instructor forbidden (403)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } } ],
          "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{otherInstructorToken}}" } ], "body": { "mode": "raw", "raw": "{\"title\":\"nope\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/courses/1", "host": ["{{baseUrl}}"], "path": ["courses", "1"] } },
          "response": []
        },
        {
          "name": "POST /courses/1/students — enroll + unenroll (200)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + added/removed counts', () => { pm.response.to.have.status(200); pm.expect(j.added).to.be.a('number'); pm.expect(j.removed).to.be.a('number'); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "body": { "mode": "raw", "raw": "{\"add\":[11,12],\"remove\":[4]}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/courses/1/students", "host": ["{{baseUrl}}"], "path": ["courses", "1", "students"] } },
          "response": []
        },
        {
          "name": "GET /courses/1/students — enrolled ids (owner/admin)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + students array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().students).to.be.an('array'); });"
          ] } } ],
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{instructorToken}}" } ], "url": { "raw": "{{baseUrl}}/courses/1/students", "host": ["{{baseUrl}}"], "path": ["courses", "1", "students"] } },
          "response": []
        },
        {
          "name": "GET /courses/1/roster — CSV download (owner/admin)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + text/csv', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'); });"
          ] } } ],
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "url": { "raw": "{{baseUrl}}/courses/1/roster", "host": ["{{baseUrl}}"], "path": ["courses", "1", "roster"] } },
          "response": []
        },
        {
          "name": "GET /courses/1/assignments — assignment ids (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 + assignments array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().assignments).to.be.an('array'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses/1/assignments", "host": ["{{baseUrl}}"], "path": ["courses", "1", "assignments"] } },
          "response": []
        },
        {
          "name": "DELETE /courses — admin deletes created (204)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204', () => pm.response.to.have.status(204));"
          ] } } ],
          "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "url": { "raw": "{{baseUrl}}/courses/{{createdCourseId}}", "host": ["{{baseUrl}}"], "path": ["courses", "{{createdCourseId}}"] } },
          "response": []
        }
      ]
    },
    {
      "name": "assignments",
      "description": "Assignment CRUD. Public reads; create/update/delete are admin OR the instructor who owns the assignment's course. course_id is immutable on update.",
      "item": [
        {
          "name": "POST /assignments — owner instructor creates (201)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 + id', () => { pm.response.to.have.status(201); pm.collectionVariables.set('createdAssignmentId', pm.response.json().id); });"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{instructorToken}}" } ], "body": { "mode": "raw", "raw": "{\"course_id\":1,\"title\":\"Final Project\",\"points\":100,\"due_date\":\"2025-06-10T23:59:00Z\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/assignments", "host": ["{{baseUrl}}"], "path": ["assignments"] } },
          "response": []
        },
        {
          "name": "GET /assignments/{{createdAssignmentId}} — confirm the create",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + returns the assignment just created', () => { pm.response.to.have.status(200); pm.expect(j.title).to.eql('Final Project'); pm.expect(j.points).to.eql(100); pm.expect(j.course_id).to.eql(1); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/assignments/{{createdAssignmentId}}", "host": ["{{baseUrl}}"], "path": ["assignments", "{{createdAssignmentId}}"] } },
          "response": []
        },
        {
          "name": "POST /assignments — student forbidden (403)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{studentToken}}" } ], "body": { "mode": "raw", "raw": "{\"course_id\":1,\"title\":\"X\",\"points\":10,\"due_date\":\"2025-06-01T23:59:00Z\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/assignments", "host": ["{{baseUrl}}"], "path": ["assignments"] } },
          "response": []
        },
        {
          "name": "GET /assignments/1 — detail (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + no submissions field', () => { pm.response.to.have.status(200); pm.expect(j).to.not.have.property('submissions'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/assignments/1", "host": ["{{baseUrl}}"], "path": ["assignments", "1"] } },
          "response": []
        },
        {
          "name": "PATCH /assignments/1 — owner edits (200)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } } ],
          "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{instructorToken}}" } ], "body": { "mode": "raw", "raw": "{\"points\":120}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/assignments/1", "host": ["{{baseUrl}}"], "path": ["assignments", "1"] } },
          "response": []
        },
        {
          "name": "GET /assignments/1 — confirm the edit applied",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + points reflect the PATCH', () => { pm.response.to.have.status(200); pm.expect(j.points).to.eql(120); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/assignments/1", "host": ["{{baseUrl}}"], "path": ["assignments", "1"] } },
          "response": []
        },
        {
          "name": "PATCH /assignments/1 — course_id immutable (400)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } } ],
          "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "body": { "mode": "raw", "raw": "{\"course_id\":3,\"title\":\"moved\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/assignments/1", "host": ["{{baseUrl}}"], "path": ["assignments", "1"] } },
          "response": []
        },
        {
          "name": "DELETE /assignments — admin deletes created (204)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204', () => pm.response.to.have.status(204));"
          ] } } ],
          "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "url": { "raw": "{{baseUrl}}/assignments/{{createdAssignmentId}}", "host": ["{{baseUrl}}"], "path": ["assignments", "{{createdAssignmentId}}"] } },
          "response": []
        }
      ]
    }
  ]
}
