    {
      "name": "courses",
      "description": "Course list filtering + pagination and CRUD. Reads (list, filters, GET /courses/1) hit seed data and never modify it. Create/edit/enroll all target a throwaway course captured in createdCourseId. Public reads need no token; create/delete are admin-only; update/enroll/students/roster are admin OR the course's own instructor.",
      "item": [
        {
          "name": "GET /courses — paginated list (public, read-only)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json();",
            "pm.test('200 + paginated courses', () => { pm.response.to.have.status(200); pm.expect(j.courses).to.be.an('array'); pm.expect(j.totalPages).to.be.a('number'); });"
          ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] } },
          "response": []
        },
